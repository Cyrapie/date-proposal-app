# ==============================================================================
# Copiez ce fichier en .env.local puis renseignez les valeurs.
#   cp .env.example .env.local
# ==============================================================================

# --- Supabase -----------------------------------------------------------------
# Tableau de bord Supabase → Project Settings → Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon

# Clé service_role : contourne RLS, utilisée uniquement côté serveur pour le
# parcours destinataire (qui n'a aucune session).
# ⚠️ Ne jamais préfixer par NEXT_PUBLIC_, ne jamais committer.
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role

# --- Application --------------------------------------------------------------
# Base des liens générés (/d/[slug]) et des redirections de connexion.
# En production : https://votre-domaine.fr
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Durée de validité par défaut d'un lien, en jours (RGPD).
# Doit faire partie de EXPIRY_OPTIONS : 7, 14, 30, 60 ou 90.
NEXT_PUBLIC_DEFAULT_LINK_EXPIRY_DAYS=30

# --- Resend (emails transactionnels) ------------------------------------------
# Optionnel en local : sans clé, les emails sont journalisés dans la console
# au lieu d'être envoyés, et le reste du parcours fonctionne normalement.
RESEND_API_KEY=
# Expéditeur. `onboarding@resend.dev` fonctionne sans domaine vérifié, mais
# n'envoie qu'à l'adresse du compte Resend. Pour un vrai envoi, vérifiez un
# domaine puis utilisez par exemple : Invitations <bonjour@votre-domaine.fr>
EMAIL_FROM=Invitations <onboarding@resend.dev>
EMAIL_REPLY_TO=

# Destinataire des formulaires Contact et Devenir partenaire du site vitrine.
# À défaut, EMAIL_REPLY_TO est utilisé. Si aucun des deux n'est renseigné, les
# formulaires renvoient une erreur explicite et la demande est journalisée.
INQUIRIES_TO=

# --- Cloudflare Turnstile (anti-robot des formulaires) ------------------------
# Clés gratuites sur https://dash.cloudflare.com > Turnstile.
# Les deux doivent être présentes, sinon la vérification est neutralisée et le
# formulaire reste utilisable (pratique en local).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Purge RGPD (Cron Vercel) -------------------------------------------------
# Secret partagé protégeant /api/cron/purge. Générez-en un au hasard :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
# Délai supplémentaire après expiration avant suppression définitive (jours).
PURGE_GRACE_DAYS=30

# --- Stripe (préparé, non activé) ---------------------------------------------
# Décommentez le jour où le modèle payant est branché. Voir src/lib/billing/plans.ts
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
